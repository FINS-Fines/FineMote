{
  "version": 5,
  "include": [
    "../../cmake/presets/compiler.json",
    "../../cmake/presets/config.json"
  ],
  "configurePresets": [
    {
      "name": "MC_Board-base",
      "hidden": true,
      "cacheVariables": {
        "BOARD_NAME": "MC_Board",
        "FINEMOTE_APPLICATION_OWNER": "ROOT",
        "FINEMOTE_LINK_OWNER": "ROOT",
        "ENABLE_CMSISDSP": true,
        "ENABLE_ETL": true,
        "ENABLE_FREERTOS_POSIX": true,
        "ENABLE_BLASFEO": true,
        "ENABLE_EIGEN": true,
        "FINEMOTE_EIGEN_USE_BLAS": true
      }
    },
    {
      "name": "arm-none-eabi-gcc-MC_Board-debug",
      "displayName": "arm-none-eabi-gcc / MC_Board / Debug",
      "inherits": [
        "MC_Board-base",
        "compiler-arm-none-eabi-gcc",
        "config-debug"
      ]
    },
    {
      "name": "arm-none-eabi-gcc-MC_Board-release",
      "displayName": "arm-none-eabi-gcc / MC_Board / Release",
      "inherits": [
        "MC_Board-base",
        "compiler-arm-none-eabi-gcc",
        "config-release"
      ]
    },
    {
      "name": "armclang-MC_Board-debug",
      "displayName": "ArmClang / MC_Board / Debug",
      "inherits": [
        "MC_Board-base",
        "compiler-armclang",
        "config-debug"
      ]
    },
    {
      "name": "armclang-MC_Board-release",
      "displayName": "ArmClang / MC_Board / Release",
      "inherits": [
        "MC_Board-base",
        "compiler-armclang",
        "config-release"
      ]
    }
  ]
}
