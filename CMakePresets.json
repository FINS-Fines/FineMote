{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "compiler-armclang",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "toolchainFile": "${sourceDir}/cmake/armclang/toolchain.cmake"
    },
    {
      "name": "board-Robomaster_C",
      "hidden": true,
      "cacheVariables": {
        "BOARD_NAME": "Robomaster_C"
      }
    },
    {
      "name": "board-MC_Board",
      "hidden": true,
      "cacheVariables": {
        "BOARD_NAME": "MC_Board"
      }
    },
    {
      "name": "config-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "config-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "armclang-Robomaster_C-debug",
      "displayName": "ArmClang / Robomaster_C / Debug",
      "inherits": [
        "compiler-armclang",
        "board-Robomaster_C",
        "config-debug"
      ]
    },
    {
      "name": "armclang-Robomaster_C-release",
      "displayName": "ArmClang / Robomaster_C / Release",
      "inherits": [
        "compiler-armclang",
        "board-Robomaster_C",
        "config-release"
      ]
    },
    {
      "name": "armclang-MC_Board-debug",
      "displayName": "ArmClang / MC_Board / Debug",
      "inherits": [
        "compiler-armclang",
        "board-MC_Board",
        "config-debug"
      ]
    },
    {
      "name": "armclang-MC_Board-release",
      "displayName": "ArmClang / MC_Board / Release",
      "inherits": [
        "compiler-armclang",
        "board-MC_Board",
        "config-release"
      ]
    }
  ]
}
